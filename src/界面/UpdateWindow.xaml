<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="更新客户端" Width="600" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{DynamicResource DialogPaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <Grid Margin="24,0,18,0">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="更新客户端" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="替换程序，继续使用原来的账号和设置" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,4,0,0"/></StackPanel>
      <Button x:Name="UpdateClose" Content="×" Padding="0" MinHeight="0" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32" Style="{DynamicResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="关闭更新说明"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="24,10,24,0">
      <TextBlock Text="1. 获取新版“3XUI-Panel-Manager.exe”。" FontSize="13"/>
      <TextBlock Text="2. 关闭当前客户端，用新版替换下面位置的旧 EXE。" FontSize="13" Margin="0,10,0,0"/>
      <TextBlock Text="3. 再次打开，账号、额度、备注和刷新设置会继续保留。" FontSize="13" Margin="0,10,0,0"/>
      <TextBlock Text="程序文件" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,6"/>
      <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="7" Padding="10"><TextBlock x:Name="ProgramLocation" FontSize="12" TextTrimming="CharacterEllipsis"/></Border>
      <TextBlock Text="数据目录 · 更新时保留此目录" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
      <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="7" Padding="10"><TextBlock x:Name="DataLocation" FontSize="12" TextTrimming="CharacterEllipsis"/></Border>
      <TextBlock Text="在线更新尚未接入发布地址，目前通过新版 EXE 更新。" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
      <Grid><Button x:Name="OpenProgramFolder" Content="打开程序位置" Height="34" HorizontalAlignment="Left" AutomationProperties.Name="打开程序位置"/><Button x:Name="UpdateDone" Content="知道了" Style="{DynamicResource PrimaryButton}" Height="34" MinWidth="80" HorizontalAlignment="Right" AutomationProperties.Name="知道了"/></Grid>
    </Border>
  </Grid>
</Window>
