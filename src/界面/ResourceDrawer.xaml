<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="22,20,22,24">
      <DockPanel><Button x:Name="CloseDrawer" DockPanel.Dock="Right" Style="{DynamicResource InlineIconButton}" Width="28" Height="28" ToolTip="关闭资源监控" AutomationProperties.Name="关闭资源监控"><Path Data="{DynamicResource IcoClose}" Style="{DynamicResource Ico}" Stroke="{DynamicResource MutedBrush}" Width="12" Height="12"/></Button><StackPanel><TextBlock x:Name="MonitorServerName" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MonitorLocation" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,4,0,0"/><Button x:Name="MonitorSource" Style="{DynamicResource MiniLinkButton}" Padding="0" HorizontalAlignment="Left" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <DockPanel Margin="0,20,0,12"><Button x:Name="RefreshResource" DockPanel.Dock="Right" Content="刷新采样" Style="{DynamicResource ChipButton}"/><TextBlock x:Name="MonitorSampleTime" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
      <Border x:Name="MonitorWarning" Background="{DynamicResource WarnSoftBrush}" CornerRadius="7" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="MonitorWarningText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource WarnBrush}"/></Border>
      <UniformGrid Columns="2">
        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="9" Padding="14" Margin="0,0,5,10"><StackPanel><TextBlock Text="CPU" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/><TextBlock x:Name="MonitorCpu" Text="—" FontSize="26" Margin="0,5,0,4"/><TextBlock x:Name="MonitorCpuInfo" Text="待检测" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="MonitorCpuMeter" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100"/></StackPanel></Border>
        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="9" Padding="14" Margin="5,0,0,10"><StackPanel><TextBlock Text="内存" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/><TextBlock x:Name="MonitorMemory" Text="—" FontSize="26" Margin="0,5,0,4"/><TextBlock x:Name="MonitorMemoryInfo" Text="待检测" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="MonitorMemoryMeter" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100"/></StackPanel></Border>
        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="9" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="磁盘" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/><TextBlock x:Name="MonitorDisk" Text="—" FontSize="26" Margin="0,5,0,4"/><TextBlock x:Name="MonitorDiskInfo" Text="待检测" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="MonitorDiskMeter" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100"/></StackPanel></Border>
        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="9" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="交换空间" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/><TextBlock x:Name="MonitorSwap" Text="—" FontSize="26" Margin="0,5,0,4"/><TextBlock x:Name="MonitorSwapInfo" Text="待检测" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="MonitorSwapMeter" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100"/></StackPanel></Border>
      </UniformGrid>
      <DockPanel Margin="0,22,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Range5" Content="5 分钟" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="Range30" Content="30 分钟" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="Range360" Content="6 小时" Style="{DynamicResource MiniLinkButton}"/></StackPanel><TextBlock Text="网络速率" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel Margin="0,0,0,6"><TextBlock x:Name="MonitorUpload" Text="↑ —" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"/><TextBlock x:Name="MonitorDownload" Text="↓ —" FontSize="12" Foreground="{DynamicResource InfoBrush}"/></WrapPanel>
      <Grid x:Name="NetworkChartHost" Height="184"><Canvas x:Name="NetworkChart" Background="Transparent" ClipToBounds="True" ToolTip="移动指针查看已采集的速率"><Canvas.Resources/></Canvas><TextBlock x:Name="NetworkChartEmpty" Text="等待真实采样" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      <TextBlock x:Name="NetworkChartHover" Text="客户端采样 · 尚无历史" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="连接数" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,10"/>
      <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="8" Padding="12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MonitorConnections" Text="—" FontSize="22"/><TextBlock x:Name="MonitorTcp" Text="TCP —" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,12,0"/><TextBlock x:Name="MonitorUdp" Text="UDP —" FontSize="11.5" VerticalAlignment="Center"/></StackPanel></Border>
      <TextBlock Text="系统套接字数量，不等于在线用户数" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,5,0,0"/>
      <TextBlock Text="系统与面板" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
        <TextBlock Text="系统运行" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorOsUptime" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
        <TextBlock Grid.Row="1" Text="Xray" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorXray" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
        <TextBlock Grid.Row="2" Text="Xray 运行" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorXrayUptime" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
        <TextBlock Grid.Row="3" Text="面板内存 / Go 协程" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorPanel" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
        <TextBlock Grid.Row="4" Text="系统负载 1 / 5 / 15 分钟" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorLoad" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
        <TextBlock Grid.Row="5" Text="服务器延迟" Foreground="{DynamicResource FaintBrush}" FontSize="11.5"/><TextBlock x:Name="MonitorLatency" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" FontSize="11.5"/>
      </Grid>
      <TextBlock Text="累计网卡流量" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,10"/>
      <DockPanel><TextBlock x:Name="MonitorReceived" DockPanel.Dock="Right" FontSize="11.5"/><TextBlock x:Name="MonitorSent" FontSize="11.5"/></DockPanel>
      <TextBlock Text="网卡累计可能在服务器重启或网卡变化后归零；套餐额度仍在服务器编辑中设置。历史曲线仅来自本次客户端运行期间的真实采样。" TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}" FontSize="11" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
