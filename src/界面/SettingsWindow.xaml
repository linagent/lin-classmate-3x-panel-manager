<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑服务器" Width="648" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- grok-step4: mockup .modal (600 wide, radius 14, two-column fields 36 high, terracotta focus ring).
       The outer 24px margin holds the drop shadow; the shadow is a separate layer so text stays crisp. -->
  <Grid Margin="24">
    <Border Background="{DynamicResource DialogPaperBrush}" CornerRadius="14">
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.22" Color="#28190F"/></Border.Effect>
    </Border>
    <Border x:Name="DialogFrame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="DialogHeader" Background="Transparent" Margin="22,18,16,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
            <Path Data="{DynamicResource IcoServer}" Style="{DynamicResource Ico}" Stroke="{DynamicResource AccentHoverBrush}" Width="18" Height="18"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="SettingsTitle" Text="编辑服务器" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="SettingsAddress" Text="保存后可在卡片上一键进入 3x-ui 面板" Foreground="{DynamicResource FaintBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button x:Name="CloseDialog" Grid.Column="2" Style="{DynamicResource InlineIconButton}" Width="30" Height="30" VerticalAlignment="Top" ToolTip="关闭（不保存）" AutomationProperties.Name="关闭">
            <Path Data="{DynamicResource IcoClose}" Style="{DynamicResource Ico}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" Width="12" Height="12"/>
          </Button>
        </Grid>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Focusable="False">
          <Grid Margin="22,12,22,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- Row 0: name | client group -->
            <StackPanel Margin="0,0,0,12">
              <TextBlock Style="{DynamicResource FieldLabel}"><Run Text="名称"/><Run Text=" *" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
              <TextBox x:Name="NameBox" AutomationProperties.Name="名称"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,12">
              <TextBlock Text="客户分组" Style="{DynamicResource FieldLabel}"/>
              <ContentControl x:Name="GroupShell" Style="{DynamicResource FieldShell}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border x:Name="GroupAvatar" Width="16" Height="16" CornerRadius="5" Background="#D08A68" Margin="0,0,8,0" Visibility="Collapsed">
                    <TextBlock x:Name="GroupAvatarText" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBox x:Name="GroupBox" Grid.Column="1" Style="{DynamicResource BareTextBox}" ToolTip="最多 20 个字，可从已有分组选择" AutomationProperties.Name="客户分组"/>
                  <TextBlock x:Name="GroupPlaceholder" Grid.Column="1" Text="不分组" Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False" Margin="2,0,0,0"/>
                  <Button x:Name="GroupPick" Grid.Column="2" Style="{DynamicResource InlineIconButton}" Margin="4,0,-6,0" ToolTip="从已有分组选择" AutomationProperties.Name="从已有分组选择">
                    <Path Data="{DynamicResource IcoChevron}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.3" Width="10" Height="10"><Path.LayoutTransform><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Path.LayoutTransform></Path>
                  </Button>
                </Grid>
              </ContentControl>
            </StackPanel>
            <!-- Row 1: panel URL (full) -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
              <TextBlock Style="{DynamicResource FieldLabel}"><Run Text="面板地址"/><Run Text=" *" Foreground="{DynamicResource AccentBrush}"/><Run Text="  http(s)://IP:端口/路径" FontWeight="Normal" FontSize="11" Foreground="{DynamicResource FaintBrush}"/></TextBlock>
              <ContentControl Style="{DynamicResource FieldShell}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Path Data="{DynamicResource IcoGlobe}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" Width="16" Height="16" Margin="0,0,8,0"><Path.LayoutTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Path.LayoutTransform></Path>
                  <TextBox x:Name="UrlBox" Grid.Column="1" Style="{DynamicResource BareTextBox}" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" AutomationProperties.Name="面板地址"/>
                  <TextBlock x:Name="UrlKind" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="8,0,0,0"/>
                </Grid>
              </ContentControl>
            </StackPanel>
            <!-- Row 2: username | password -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
              <TextBlock Style="{DynamicResource FieldLabel}"><Run Text="用户名"/><Run Text=" *" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
              <ContentControl Style="{DynamicResource FieldShell}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Path Data="{DynamicResource IcoUser}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" Width="16" Height="16" Margin="0,0,8,0"><Path.LayoutTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Path.LayoutTransform></Path>
                  <TextBox x:Name="AccountBox" Grid.Column="1" Style="{DynamicResource BareTextBox}" AutomationProperties.Name="用户名"/>
                </Grid>
              </ContentControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
              <TextBlock Style="{DynamicResource FieldLabel}"><Run Text="密码"/><Run Text=" *" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
              <ContentControl Style="{DynamicResource FieldShell}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Path Data="{DynamicResource IcoLock}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" Width="16" Height="16" Margin="0,0,8,0"><Path.LayoutTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Path.LayoutTransform></Path>
                  <PasswordBox x:Name="SecretBox" Grid.Column="1" Style="{DynamicResource BarePasswordBox}" AutomationProperties.Name="密码"/>
                  <TextBox x:Name="SecretPlain" Grid.Column="1" Style="{DynamicResource BareTextBox}" Visibility="Collapsed" AutomationProperties.Name="密码（明文）"/>
                  <CheckBox x:Name="SecretReveal" Grid.Column="2" Style="{DynamicResource EyeToggle}" Margin="4,0,-5,0" ToolTip="显示 / 隐藏密码" AutomationProperties.Name="显示密码"/>
                </Grid>
              </ContentControl>
            </StackPanel>
            <!-- Region is explicit local metadata so similarly named servers remain distinguishable. -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
              <TextBlock Text="国家 / 地区" Style="{DynamicResource FieldLabel}"/>
              <TextBox x:Name="CountryBox" MaxLength="32" ToolTip="例如：美国、英国、中国香港；留空时根据服务器名称识别。" AutomationProperties.Name="国家或地区"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
              <TextBlock Text="城市 / 位置" Style="{DynamicResource FieldLabel}"/>
              <TextBox x:Name="CityBox" MaxLength="48" ToolTip="例如：洛杉矶、西雅图、加州；在卡片副标题显示。" AutomationProperties.Name="城市或位置"/>
            </StackPanel>
            <!-- Local traffic quota | expiry date -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
              <DockPanel Margin="0,0,0,6">
                <Button x:Name="TotalTrafficClear" DockPanel.Dock="Right" Content="清除" Style="{DynamicResource MiniLinkButton}" Foreground="{DynamicResource FaintBrush}" Margin="0,-3,-6,-3" ToolTip="不设置总流量"/>
                <TextBlock Text="总流量" Style="{DynamicResource FieldLabel}" Margin="0"/>
              </DockPanel>
              <ContentControl Style="{DynamicResource FieldShell}" ToolTip="只保存到本机，留空表示不设置。GB/TB 为十进制，GiB/TiB 为二进制。">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TotalTrafficBox" Style="{DynamicResource BareTextBox}" FontFamily="{DynamicResource MonoFont}" MaxLength="24" AutomationProperties.Name="总流量"/>
                  <TextBlock x:Name="TotalTrafficPlaceholder" Text="留空不设置" Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False" Margin="2,0,0,0"/>
                  <ComboBox x:Name="TotalTrafficUnit" Grid.Column="1" Width="70" Height="32" Margin="8,-5,-8,-5" FontSize="11.5" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" SelectedIndex="0" AutomationProperties.Name="流量单位" ToolTip="1 GB = 10⁹ 字节；1 TB = 10¹² 字节；1 GiB = 2³⁰ 字节；1 TiB = 2⁴⁰ 字节。">
                    <ComboBoxItem Content="GB"/><ComboBoxItem Content="TB"/><ComboBoxItem Content="GiB"/><ComboBoxItem Content="TiB"/>
                  </ComboBox>
                </Grid>
              </ContentControl>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="到期时间" Style="{DynamicResource FieldLabel}" Margin="0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,-3,-6,-3">
                  <Button x:Name="ExpiryAddMonth" Content="+1 月" Style="{DynamicResource MiniLinkButton}" ToolTip="在当前到期日（或今天）基础上加 1 个月"/>
                  <Button x:Name="ExpiryAddYear" Content="+1 年" Style="{DynamicResource MiniLinkButton}" ToolTip="在当前到期日（或今天）基础上加 1 年"/>
                  <Button x:Name="ExpiryClear" Content="清除" Style="{DynamicResource MiniLinkButton}" Foreground="{DynamicResource FaintBrush}" ToolTip="不设置到期日"/>
                </StackPanel>
              </Grid>
              <ContentControl x:Name="ExpiryShell" Style="{DynamicResource FieldShell}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ExpiryBox" Style="{DynamicResource BareTextBox}" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" ToolTip="格式 yyyy-MM-dd，留空表示不设置" AutomationProperties.Name="到期日"/>
                  <TextBlock x:Name="ExpiryPlaceholder" Text="yyyy-MM-dd · 留空不设置" FontSize="12.5" Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False" Margin="2,0,0,0"/>
                  <Button x:Name="ExpiryPick" Grid.Column="1" Style="{DynamicResource InlineIconButton}" Margin="4,0,-6,0" ToolTip="从日历选择" AutomationProperties.Name="从日历选择到期日">
                    <Path Data="{DynamicResource IcoCalendar}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.4" Width="16" Height="16"><Path.LayoutTransform><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Path.LayoutTransform></Path>
                  </Button>
                  <Popup x:Name="ExpiryPopup" PlacementTarget="{Binding ElementName=ExpiryShell}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,6,0,0"><Calendar x:Name="ExpiryCalendar"/></Border>
                  </Popup>
                </Grid>
              </ContentControl>
            </StackPanel>
            <!-- Note (full) -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,12">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="备注" Style="{DynamicResource FieldLabel}" Margin="0"/>
                <TextBlock x:Name="NoteCounter" Grid.Column="2" Text="0 / 200" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"/>
              </Grid>
              <TextBox x:Name="NoteBox" Height="58" Padding="11,7" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="备注"/>
            </StackPanel>
            <TextBlock x:Name="MetadataUnavailable" Grid.Row="6" Grid.ColumnSpan="3" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
            <!-- Row 6: security note (mockup .secure) -->
            <Border Grid.Row="7" Grid.ColumnSpan="3" Background="{DynamicResource NoteWellBrush}" CornerRadius="8" Padding="10,7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="{DynamicResource IcoShield}" Style="{DynamicResource Ico}" Stroke="{DynamicResource FaintBrush}" Width="16" Height="16" VerticalAlignment="Top"><Path.LayoutTransform><ScaleTransform ScaleX="0.82" ScaleY="0.82"/></Path.LayoutTransform></Path>
                <TextBlock x:Name="SettingsHelp" Grid.Column="1" Text="账号密码用 Windows DPAPI 加密，仅保存在本机，不会上传任何服务器。" ToolTip="到期日 / 分组 / 备注同样只保存在本机（服务器元数据.json），不会联网。" Foreground="{DynamicResource FaintBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="7,0,0,0"/>
              </Grid>
            </Border>
            <TextBlock x:Name="SettingsError" Grid.Row="8" Grid.ColumnSpan="3" Foreground="{DynamicResource BadBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </ScrollViewer>
        <!-- Footer (mockup .m-foot): 测试连接 runs the real read-only check for this saved server. -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="22,14,22,18" Margin="0,8,0,0">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelSettings" Content="取消" IsCancel="True" Height="36" Margin="0,0,10,0"/>
              <Button x:Name="SaveSettings" Content="保存" IsDefault="True" Height="36" Padding="22,0" Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
            <Button x:Name="TestConnection" Height="36" ToolTip="用已保存的账号对这台服务器做一次只读检测（点击后才联网）" AutomationProperties.Name="测试连接">
              <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource IcoPulse}" Style="{DynamicResource Ico}" Stroke="{DynamicResource InkBrush}" Width="16" Height="16"><Path.LayoutTransform><ScaleTransform ScaleX="0.88" ScaleY="0.88"/></Path.LayoutTransform></Path>
                <TextBlock Text="测试连接" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
            <Border x:Name="TestResult" Height="30" CornerRadius="7" BorderThickness="1" Padding="10,0" Margin="10,0,0,0" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessLineBrush}" Visibility="Collapsed" MaxWidth="250">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="TestResultIcon" Data="{DynamicResource IcoCheck}" Style="{DynamicResource Ico}" Stroke="{DynamicResource SuccessTextBrush}" StrokeThickness="2" Width="16" Height="16"><Path.LayoutTransform><ScaleTransform ScaleX="0.88" ScaleY="0.88"/></Path.LayoutTransform></Path>
                <TextBlock x:Name="TestResultText" FontSize="12.5" Foreground="{DynamicResource SuccessTextBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
