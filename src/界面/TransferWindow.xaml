<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="跨电脑账号迁移" Width="510" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="TransferTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="TransferHelp" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,22"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="迁移密码" Margin="0,0,0,8"/><PasswordBox x:Name="TransferPassword"/><StackPanel x:Name="ConfirmGroup" Margin="0,16,0,0"><TextBlock Text="再次输入" Margin="0,0,0,8"/><PasswordBox x:Name="ConfirmPassword"/></StackPanel><TextBlock x:Name="TransferError" Foreground="#AE583D" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" IsCancel="True" Width="90" Margin="0,0,10,0"/><Button x:Name="ConfirmTransfer" Content="继续" IsDefault="True" Width="100" Style="{DynamicResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
