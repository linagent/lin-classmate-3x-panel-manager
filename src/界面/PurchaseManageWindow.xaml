<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="管理服务商与购买账号" Width="680" Height="540" MinWidth="580" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" ShowInTaskbar="False">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="服务商与购买账号" FontSize="18" FontWeight="Bold"/><TextBlock Text="服务商 → 购买账号 → 服务器，独立于客户分组和 3X-UI 账号" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,6,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="服务商" Style="{DynamicResource FieldLabel}"/><ListBox x:Name="ProviderList" DisplayMemberPath="Name" SelectedValuePath="Id" Height="170"/><TextBox x:Name="ProviderNameBox" MaxLength="64" Margin="0,12,0,0" AutomationProperties.Name="服务商名称"/><WrapPanel Margin="0,10,0,0"><Button x:Name="NewProvider" Content="新建" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="SaveProvider" Content="保存名称" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="DeleteProvider" Content="删除" Style="{DynamicResource MiniLinkButton}" Foreground="{DynamicResource BadBrush}"/></WrapPanel></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="购买账号" Style="{DynamicResource FieldLabel}"/><ListBox x:Name="AccountList" DisplayMemberPath="Alias" SelectedValuePath="Id" Height="170"/><TextBox x:Name="AccountAliasBox" MaxLength="64" Margin="0,12,0,0" AutomationProperties.Name="购买账号别名"/><TextBox x:Name="AccountHintBox" MaxLength="120" Margin="0,8,0,0" AutomationProperties.Name="购买账号提示" ToolTip="账号提示，可选"/><WrapPanel Margin="0,10,0,0"><Button x:Name="NewPurchaseAccount" Content="新建" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="SavePurchaseAccount" Content="保存账号" Style="{DynamicResource MiniLinkButton}"/><Button x:Name="DeletePurchaseAccount" Content="删除" Style="{DynamicResource MiniLinkButton}" Foreground="{DynamicResource BadBrush}"/></WrapPanel></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="PurchaseManageError" FontSize="12" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"/><TextBlock Text="正在使用的账号需先解除服务器归属；有账号的服务商需先处理账号。" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="ClosePurchaseManage" Content="完成" HorizontalAlignment="Right" Width="84" Margin="0,14,0,0" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
